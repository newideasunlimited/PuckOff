# SPDX-License-Identifier: Apache-2.0

choice PUCKOFF_TRANSPORT
	prompt "PuckOff transport and radio owner"
	default PUCKOFF_TRANSPORT_USB_RAW_RF

config PUCKOFF_TRANSPORT_USB_RAW_RF
	bool "USB gamepad with exclusive proprietary radio"
	help
	  The default receiver. Bluetooth and MPSL must be disabled because the
	  polling driver owns RADIO directly.

config PUCKOFF_TRANSPORT_BLE_DIAGNOSTIC
	bool "BLE HID diagnostic (no controller radio)"
	depends on SOC_NRF52840 && BT && BT_PERIPHERAL
	help
	  Advertise a BLE HID gamepad, with neutral input and explicit serial
	  diagnostic commands only. This is not a Steam Controller receiver.
	  The raw radio driver and controller link are not compiled.

config PUCKOFF_TRANSPORT_BLE_BRIDGE
	bool "Controller to a Bluetooth LE gamepad, sharing the radio"
	depends on SOC_NRF52840 && BT && BT_PERIPHERAL && BT_LL_SOFTDEVICE
	help
	  The controller link runs inside MPSL timeslots next to the SoftDevice
	  Controller, and controller input goes to one connected BLE HID host.
	  With no BLE host connected, input goes to the USB gamepad instead.

endchoice

config PUCKOFF_BLE_GAMEPAD_ONLY
	bool "Expose only the gamepad collection over Bluetooth"
	depends on PUCKOFF_TRANSPORT_BLE_BRIDGE || PUCKOFF_TRANSPORT_BLE_DIAGNOSTIC
	help
	  The report map and the HID service carry the gamepad report only; the
	  keyboard, mouse and consumer collections used by TV remote mode are
	  left out and "ble mode remote" is refused. macOS treats a device that
	  also carries a keyboard collection as a protected input device and
	  does not hand its gamepad reports to apps. The host sees a different
	  GATT database, so forget and re-pair the board after changing this.

config PUCKOFF_SNIFFER
	bool "Passive link sniffer instead of the receiver"
	depends on PUCKOFF_TRANSPORT_USB_RAW_RF && SHELL
	help
	  Never transmit. Follow another receiver's advertisements from the
	  rendezvous address to its session and print the packets exchanged
	  there on the console, so over-air formats can be confirmed from our
	  own captures. The controller link, polling and USB input are off;
	  pairing identifiers and session addresses are never printed.
